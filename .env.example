# Run python -m jarvis configure to generate a private local API token.
JARVIS_API_TOKEN=
JARVIS_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
TAVILY_API_KEY=
JARVIS_TIMEZONE=Europe/Brussels
JARVIS_DATA_DIR=./data
# JSON arrays of absolute directories; empty disables file access.
JARVIS_READ_ROOTS=[]
JARVIS_WRITE_ROOTS=[]
JARVIS_ALLOWED_ORIGINS=[]
# Exact tool names that may execute without approval. Reads and reversible
# local writes already have defaults. Do not grant broad destructive access.
JARVIS_STANDING_PERMISSIONS=[]
JARVIS_MAX_TOOL_CALLS=12
JARVIS_RUN_TIMEOUT=180
JARVIS_CONTEXT_CHARS=32000
JARVIS_OUTPUT_TOKENS=512
JARVIS_APPROVAL_TTL=120
# Total service deadlines in seconds, including retries and body downloads.
JARVIS_PROVIDER_TIMEOUT=40
JARVIS_STT_TIMEOUT=20
JARVIS_TTS_TIMEOUT=30
JARVIS_SEARCH_TIMEOUT=20
# Bound connection setup and pool queues; reuse idle TLS connections for a minute.
JARVIS_CONNECT_TIMEOUT=5
JARVIS_POOL_TIMEOUT=1
JARVIS_KEEPALIVE_EXPIRY=60

